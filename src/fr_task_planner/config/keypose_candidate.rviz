Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Name: Workcell
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 0.05
      Value: true
    - Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: Keypose Candidate
      Robot Description: robot_description
      Robot State Topic: /keypose/preview/robot_state
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Keypose Markers
      Topic: /keypose/preview/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.2
      Focal Point:
        X: 0.0
        Y: 0.20
        Z: 0.80
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: 0.80
    Saved: ~
Window Geometry:
  Height: 960
  Width: 1400
  X: 40
  Y: 40
