Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: moveit_task_constructor/Motion Planning Tasks
    Global Settings:
      Task View Settings:
        Show Computation Times: true
        Task Expansion: All Expanded
    Name: Motion Planning Tasks
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Class: moveit_task_constructor/Motion Planning Tasks
      Enabled: true
      Interrupt Display: false
      Loop Animation: true
      Name: Motion Planning Tasks
      Robot Description: robot_description
      Show Trail: false
      Task Solution Topic: /solution
      Value: true
    - Class: moveit_rviz_plugin/PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Name: PlanningScene
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Inspection Markers
      Topic: /fr3_vis/markers
      Value: true
    - Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: TopCircle Collision Ghost
      Robot Description: robot_description
      Robot State Topic: /fr3_vis/collision_robot_state
      Value: true
    - Class: moveit_rviz_plugin/Trajectory
      Enabled: true
      Name: Planned Trajectory
      Robot Description: robot_description
      Trajectory Topic: /display_planned_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.8
      Focal Point:
        X: 0
        Y: 0.25
        Z: 0.9
      Name: Current View
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Yaw: 0.95
    Saved: ~
Window Geometry:
  Height: 960
  Width: 1680
  X: 0
  Y: 0
