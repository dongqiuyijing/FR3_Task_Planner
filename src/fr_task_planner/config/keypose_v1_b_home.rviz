Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: B_HOME
      Robot Description: robot_description
      Robot State Topic: /keypose/preview/robot_state
      Value: true
    - Class: moveit_rviz_plugin/RobotState
      Enabled: true
      Name: B_PRE_HANDOVER
      Robot Description: robot_description
      Robot State Topic: /keypose/preview/robot_state_pre
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Keypose Markers
      Topic: /keypose/preview/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point:
        X: -0.2
        Y: 0.45
        Z: 0.85
      Name: Current View
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Yaw: 2.4
    Saved: ~
Window Geometry:
  Height: 960
  Width: 1400
  X: 40
  Y: 40
